#!/usr/bin/env python3
"""
AI 艺术评鉴生成脚本

读取 Obsidian 笔记中的描述，调用 AI 生成高水平艺术评鉴，并写回笔记。
支持 Ollama（本地）、Kimi API、OpenAI API 等多种后端。
"""

import argparse
import json
import os
import re
import sys
import time
from datetime import datetime
from pathlib import Path
from typing import Optional

import frontmatter
import requests

sys.path.insert(0, str(Path(__file__).parent))
from utils import now_str

PROJECT_ROOT = Path(__file__).parent.parent.resolve()
DEFAULT_VAULT = PROJECT_ROOT / "kb"

PROMPT_TEMPLATE = """你是一位深耕中国传统织绣艺术的研究者与策展人，文笔典雅、见解独到。
请根据以下藏品描述，撰写一段 200-300 字的艺术评鉴。

要求：
1. 语言优美，富有文学性与文化厚度；
2. 从工艺、纹样、色彩、历史意蕴、审美价值等角度切入；
3. 避免空话套话，要有具体观察和独到观点；
4. 保持客观，不夸大；
5. 只输出评鉴正文，不要标题、不要分点、不要"综上所述"等总结词。

藏品描述：
{description}
"""


def generate_with_ollama(prompt: str, model: str = "qwen3:0.6b", base_url: str = "http://localhost:11434") -> str:
    """使用 Ollama 本地模型生成文本"""
    url = f"{base_url}/api/generate"
    payload = {
        "model": model,
        "prompt": prompt,
        "stream": False,
        "options": {
            "temperature": 0.7,
            "num_predict": 512
        }
    }

    try:
        response = requests.post(url, json=payload, timeout=120)
        response.raise_for_status()
        data = response.json()
        return data.get("response", "").strip()
    except Exception as e:
        raise RuntimeError(f"Ollama 调用失败: {e}")


def generate_with_openai_compatible(prompt: str, api_key: str, base_url: str, model: str) -> str:
    """使用 OpenAI 兼容 API 生成文本"""
    url = f"{base_url.rstrip('/')}/chat/completions"
    headers = {
        "Authorization": f"Bearer {api_key}",
        "Content-Type": "application/json"
    }
    payload = {
        "model": model,
        "messages": [
            {"role": "system", "content": "你是一位中国传统织绣艺术研究专家，擅长撰写典雅、专业的艺术评鉴。"},
            {"role": "user", "content": prompt}
        ],
        "temperature": 0.7,
        "max_tokens": 512
    }

    try:
        response = requests.post(url, headers=headers, json=payload, timeout=120)
        response.raise_for_status()
        data = response.json()
        return data["choices"][0]["message"]["content"].strip()
    except Exception as e:
        raise RuntimeError(f"API 调用失败: {e}")


def generate_with_kimi(prompt: str, api_key: str, model: str = "moonshot-v1-8k") -> str:
    """使用 Kimi API 生成文本"""
    return generate_with_openai_compatible(
        prompt=prompt,
        api_key=api_key,
        base_url="https://api.moonshot.cn/v1",
        model=model
    )


def generate_with_openai(prompt: str, api_key: str, model: str = "gpt-4o-mini") -> str:
    """使用 OpenAI API 生成文本"""
    return generate_with_openai_compatible(
        prompt=prompt,
        api_key=api_key,
        base_url="https://api.openai.com/v1",
        model=model
    )


def generate_appreciation(description: str, provider: str, config: dict) -> str:
    """根据 provider 选择对应后端生成评鉴"""
    prompt = PROMPT_TEMPLATE.format(description=description)

    if provider == "ollama":
        return generate_with_ollama(
            prompt,
            model=config.get("model", "qwen3:0.6b"),
            base_url=config.get("base_url", "http://localhost:11434")
        )
    elif provider == "kimi":
        return generate_with_kimi(
            prompt,
            api_key=config["api_key"],
            model=config.get("model", "moonshot-v1-8k")
        )
    elif provider == "openai":
        return generate_with_openai(
            prompt,
            api_key=config["api_key"],
            model=config.get("model", "gpt-4o-mini")
        )
    elif provider == "custom":
        return generate_with_openai_compatible(
            prompt,
            api_key=config["api_key"],
            base_url=config["base_url"],
            model=config["model"]
        )
    else:
        raise ValueError(f"不支持的 provider: {provider}")


def extract_description_from_content(content: str) -> str:
    """从 Markdown 正文中提取描述部分"""
    if "## 描述" not in content:
        return content.strip()

    section = content.split("## 描述", 1)[1]
    # 取到下一个 ## 标题之前
    next_header = re.search(r'\n##\s+', section)
    if next_header:
        section = section[:next_header.start()]
    return section.strip()


def process_note(note_path: Path, provider: str, config: dict, dry_run: bool = False) -> bool:
    """处理单个笔记，返回是否生成成功"""
    try:
        post = frontmatter.load(note_path)
    except Exception as e:
        print(f"  [错误] 解析失败 {note_path}: {e}")
        return False

    content = post.content or ""
    description = extract_description_from_content(content)

    if not description or description == "（暂无描述）":
        print(f"  [跳过] 描述为空: {note_path.name}")
        return False

    # 检查是否已有评鉴
    if "## 艺术评鉴" in content:
        appreciation_section = content.split("## 艺术评鉴", 1)[1]
        next_header = re.search(r'\n##\s+', appreciation_section)
        if next_header:
            appreciation_section = appreciation_section[:next_header.start()]
        current_appreciation = appreciation_section.strip()

        # 如果评鉴不是占位符，跳过
        if current_appreciation and current_appreciation not in ["（待生成）", "待生成"]:
            return False

    try:
        appreciation = generate_appreciation(description, provider, config)
    except Exception as e:
        print(f"  [错误] 生成失败 {note_path.name}: {e}")
        return False

    if not appreciation:
        print(f"  [错误] 生成结果为空: {note_path.name}")
        return False

    if dry_run:
        print(f"  [预览] {note_path.name}\n{'='*40}\n{appreciation}\n{'='*40}")
        return True

    # 更新正文中的艺术评鉴部分
    new_content = update_appreciation_section(content, appreciation)

    # 更新 frontmatter
    post.metadata["updated_at"] = datetime.now().strftime("%Y-%m-%d")
    post.content = new_content

    try:
        with open(note_path, "w", encoding="utf-8") as f:
            f.write(frontmatter.dumps(post))
        print(f"  [完成] {note_path.name}")
        return True
    except Exception as e:
        print(f"  [错误] 写入失败 {note_path.name}: {e}")
        return False


def update_appreciation_section(content: str, appreciation: str) -> str:
    """更新正文中的艺术评鉴章节"""
    if "## 艺术评鉴" not in content:
        return content + f"\n\n## 艺术评鉴\n\n{appreciation}\n"

    parts = content.split("## 艺术评鉴", 1)
    before = parts[0]
    after = parts[1]

    # 找到下一个 ## 标题
    next_header = re.search(r'\n##\s+', after)
    if next_header:
        after_section = after[next_header.start():]
    else:
        after_section = ""

    return before + f"## 艺术评鉴\n\n{appreciation}\n" + after_section


def main():
    parser = argparse.ArgumentParser(description="AI 艺术评鉴生成脚本")
    parser.add_argument("--vault", type=str, default=str(DEFAULT_VAULT), help="Obsidian Vault 路径")
    parser.add_argument("--provider", type=str, default="ollama",
                        choices=["ollama", "kimi", "openai", "custom"],
                        help="AI 提供商")
    parser.add_argument("--model", type=str, default=None, help="模型名称")
    parser.add_argument("--api-key", type=str, default=None, help="API Key（Kimi/OpenAI/custom）")
    parser.add_argument("--base-url", type=str, default=None, help="自定义 API 基础 URL 或 Ollama 地址")
    parser.add_argument("--limit", type=int, default=None, help="最多处理条数")
    parser.add_argument("--source", type=str, default=None, help="指定来源目录，如：中国历代")
    parser.add_argument("--dry-run", action="store_true", help="仅预览，不写回笔记")
    parser.add_argument("--sleep", type=float, default=0.5, help="每次请求间隔秒数")

    args = parser.parse_args()

    vault_path = Path(args.vault)
    collections_dir = vault_path / "Collections"

    if not collections_dir.exists():
        print(f"错误: Collections 目录不存在: {collections_dir}")
        sys.exit(1)

    # 构建配置
    config = {}
    if args.model:
        config["model"] = args.model
    if args.base_url:
        config["base_url"] = args.base_url

    if args.provider in ["kimi", "openai", "custom"]:
        api_key = args.api_key or os.environ.get(f"{args.provider.upper()}_API_KEY")
        if not api_key:
            print(f"错误: 使用 {args.provider} 需要提供 --api-key 或设置 {args.provider.upper()}_API_KEY 环境变量")
            sys.exit(1)
        config["api_key"] = api_key

    # 默认模型
    if "model" not in config:
        if args.provider == "ollama":
            config["model"] = "qwen3:0.6b"
        elif args.provider == "kimi":
            config["model"] = "moonshot-v1-8k"
        elif args.provider == "openai":
            config["model"] = "gpt-4o-mini"

    # 查找笔记
    if args.source:
        note_files = list((collections_dir / args.source).glob("*.md"))
    else:
        note_files = list(collections_dir.rglob("*.md"))

    print(f"扫描到 {len(note_files)} 个笔记文件")
    print(f"使用 provider: {args.provider}, model: {config.get('model')}")

    success_count = 0
    skip_count = 0
    error_count = 0

    for idx, note_path in enumerate(note_files, 1):
        if args.limit and success_count >= args.limit:
            print(f"\n已达到限制数量 {args.limit}，停止处理")
            break

        print(f"[{idx}/{len(note_files)}] {note_path.name}")
        result = process_note(note_path, args.provider, config, args.dry_run)
        if result:
            success_count += 1
        else:
            # 判断是跳过还是错误
            try:
                post = frontmatter.load(note_path)
                content = post.content or ""
                description = extract_description_from_content(content)
                if not description or description == "（暂无描述）":
                    skip_count += 1
                elif "## 艺术评鉴" in content:
                    appreciation_section = content.split("## 艺术评鉴", 1)[1]
                    next_header = re.search(r'\n##\s+', appreciation_section)
                    if next_header:
                        appreciation_section = appreciation_section[:next_header.start()]
                    current_appreciation = appreciation_section.strip()
                    if current_appreciation and current_appreciation not in ["（待生成）", "待生成"]:
                        skip_count += 1
                    else:
                        error_count += 1
                else:
                    error_count += 1
            except Exception:
                error_count += 1

        if idx < len(note_files):
            time.sleep(args.sleep)

    print("\n=== 处理完成 ===")
    print(f"成功生成: {success_count}")
    print(f"跳过: {skip_count}")
    print(f"失败: {error_count}")


if __name__ == "__main__":
    main()
